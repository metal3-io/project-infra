#!/usr/bin/env bash

set -eux
export USERDATA_HOSTNAME=${HOSTNAME:-"metal3node-test"}

sudo sed -i "/^127.0.0.1/ s/$/ ${USERDATA_HOSTNAME}/" /etc/hosts
sudo sed -i "s/MACAddressPolicy=persistent/MACAddressPolicy=none/g" /usr/lib/systemd/network/99-default.link

for container in $(env | grep "CALICO_*" | cut -f2 -d'='); do
  sudo crictl pull "${container}"
done

# Mitigate CVE-2026-98432
cat <<'EOF' | sudo tee /etc/sysctl.d/90-cve-2026-98432.conf > /dev/null
net.ipv4.tcp_migrate_req = 0
EOF

cat <<'EOF' | sudo tee /etc/cve-2026-98432.nft > /dev/null
table ip cve_2026_98432 {
  chain input {
    type filter hook prerouting priority raw; policy accept;
    ip hdrlength != 5 drop
  }
}
EOF

cat <<'EOF' | sudo tee /etc/systemd/system/cve-2026-98432.service > /dev/null
[Unit]
Description=Drop IPv4 packets with IP options (CVE-2026-98432)
After=nftables.service
Before=network-pre.target
DefaultDependencies=no
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/cve-2026-98432.nft

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl enable cve-2026-98432.service
