{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["custom.regex"],
  "prCreation": "immediate",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": false,
  "labels": ["ok-to-test"],
  "commitMessagePrefix": ":seedling: ",
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "matchPackageNames": ["kubernetes/kubernetes"],
      "description": "Allow pre-release (alpha/beta/rc) Kubernetes versions for pre-release test tracking",
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "matchPackageNames": ["kubernetes-sigs/cluster-api"],
      "groupName": "cluster-api providers"
    },
    {
      "matchPackageNames": ["kubernetes-sigs/cluster-api-provider-openstack"],
      "groupName": "cluster-api-provider-openstack"
    },
    {
      "matchDatasources": ["docker"],
      "matchFileNames": ["prow/config/jobs/**/*.yaml"],
      "groupName": "prow container images",
      "schedule": ["monthly"]
    },
    {
      "matchDatasources": [
        "custom.centos-9-stream-genericcloud",
        "custom.centos-10-stream-genericcloud"
      ],
      "description": "Group both CentOS Stream GenericCloud image bumps into a single PR",
      "groupName": "CentOS Stream GenericCloud images"
    },
    {
      "matchDatasources": ["custom.centos-9-stream-genericcloud"],
      "description": "Only track dated GenericCloud 9 qcow2 images, not latest/checksums/other variants",
      "extractVersion": "^CentOS-Stream-GenericCloud-9-(?<version>[0-9]{8}\\.[0-9]+)\\.x86_64\\.qcow2$"
    },
    {
      "matchDatasources": ["custom.centos-10-stream-genericcloud"],
      "description": "Only track dated GenericCloud 10 qcow2 images, not latest/checksums/other variants",
      "extractVersion": "^CentOS-Stream-GenericCloud-10-(?<version>[0-9]{8}\\.[0-9]+)\\.x86_64\\.qcow2$"
    },
    {
      "matchDatasources": ["custom.ubuntu-noble-cloud-images"],
      "description": "Only track dated Ubuntu Noble release directories, not the floating release/ alias",
      "extractVersion": "^release-(?<version>[0-9]{8}(?:\\.[0-9]+)?)/$",
      "groupName": "Ubuntu Noble cloud base image"
    },
    {
      "matchDatasources": [
        "custom.centos-9-stream-genericcloud",
        "custom.centos-10-stream-genericcloud",
        "custom.ubuntu-noble-cloud-images"
      ],
      "description": "Base images only: open update PRs once a month",
      "schedule": ["* 0-3 15 * *"]
    },
    {
      "matchDatasources": ["jenkins-plugins"],
      "description": "Batch all Jenkins plugin updates into one weekly PR",
      "groupName": "Jenkins plugins",
      "schedule": ["before 6am on monday"]
    },
    {
      "matchDepNames": ["jenkinsci/oracle-cloud-infrastructure-compute-plugin"],
      "description": "Forked plugin: a bump is a NOTIFICATION only. Rebase patches, rebuild the .hpi, commit it to this branch, THEN merge. Never merge the marker bump alone.",
      "groupName": "OCI compute plugin (forked, manual rebuild)",
      "extractVersion": "^oracle-cloud-infrastructure-compute-(?<version>.+)$",
      "addLabels": ["do-not-merge/hold"],
      "schedule": ["before 6am on monday"]
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["docker.io/jenkins/jenkins"],
      "description": "Jenkins LTS core bump: before merge, run jpm.py --allplugins --update to re-validate the plugin manifest against the new core. jpm.py reads this exact image tag via get_jenkins_version(). Only X.Y.Z-lts tags are tracked.",
      "groupName": "Jenkins LTS image",
      "addLabels": ["do-not-merge/hold"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": [
        "docker.io/library/traefik",
        "ghcr.io/wollomatic/socket-proxy"
      ],
      "description": "Supporting container images for the Jenkins host (Traefik, socket-proxy)",
      "groupName": "Jenkins host supporting images",
      "minimumReleaseAge": "1 day"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the Jenkins LTS image in the application role defaults (LTS only: X.Y.Z-lts)",
      "managerFilePatterns": ["ansible/roles/application/defaults/main.yaml"],
      "matchStrings": [
        "jenkins: (?<depName>docker\\.io/jenkins/jenkins):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-lts$"
    },
    {
      "customType": "regex",
      "description": "Bump the supporting container images (Traefik, socket-proxy) in the application role defaults",
      "managerFilePatterns": ["ansible/roles/application/defaults/main.yaml"],
      "matchStrings": [
        "(?:traefik|socket-proxy): (?<depName>(?:[a-z0-9.-]+\\.[a-z]{2,})/[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track upstream releases of the forked OCI compute plugin (bump = rebuild the bundled .hpi)",
      "managerFilePatterns": ["ansible/roles/application/files/oracle-cloud-infrastructure-compute.upstream"],
      "matchStrings": ["upstream_base_version=(?<currentValue>\\S+)"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "jenkinsci/oracle-cloud-infrastructure-compute-plugin",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump Jenkins plugin versions in the Ansible plugin manifests",
      "managerFilePatterns": ["ansible/roles/application/files/jenkins-plugins-*.yaml"],
      "matchStrings": [
        "(?<depName>[A-Za-z0-9][\\w.-]*):\\s+version: '?(?<currentValue>[^'\\s]+)'?"
      ],
      "datasourceTemplate": "jenkins-plugins"
    },
    {
      "customType": "regex",
      "description": "Bump container images in Prow job configs",
      "managerFilePatterns": ["prow/config/jobs/**/*.yaml"],
      "matchStrings": [
        "image: (?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump container images in hack scripts",
      "managerFilePatterns": ["hack/*.sh"],
      "matchStrings": [
        "(?<depName>(?:[a-z0-9.-]+\\.)+[a-z]{2,}/[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Bump the target Kubernetes minor version for pre-release testing",
      "managerFilePatterns": ["jenkins/jobs/pre_release_tests.groovy"],
      "matchStrings": ["KUBERNETES_VERSION = '(?<currentValue>[^']+)'"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump GitHub release versions in CAPI kustomization",
      "managerFilePatterns": ["prow/capi/kustomization.yaml"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump Calico version in bootstrap kustomization",
      "managerFilePatterns": ["prow/bootstrap/calico/kustomization.yaml"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?<currentValue>v[^/]+)/manifests/calico\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the External Secrets Operator Helm chart version",
      "managerFilePatterns": [
        "prow/bootstrap/external-secrets-operator/kustomization.yaml"
      ],
      "matchStrings": ["version: (?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "helm",
      "packageNameTemplate": "external-secrets",
      "registryUrlTemplate": "https://charts.external-secrets.io"
    },
    {
      "customType": "regex",
      "description": "Bump the Flux Operator version in flux kustomization",
      "managerFilePatterns": ["prow/flux/kustomization.yaml"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v[^/]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the Flux distribution version in FluxInstance",
      "managerFilePatterns": ["prow/flux/flux.yaml"],
      "matchStrings": ["version: \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "fluxcd/flux2",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump CAPI core/bootstrap/control-plane provider versions",
      "managerFilePatterns": [
        "prow/capi/core.yaml",
        "prow/capi/bootstrap.yaml",
        "prow/capi/control-plane.yaml"
      ],
      "matchStrings": ["version: (?<currentValue>v[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/cluster-api",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump CAPO infrastructure provider version",
      "managerFilePatterns": ["prow/capi/infrastructure.yaml"],
      "matchStrings": ["version: (?<currentValue>v[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes-sigs/cluster-api-provider-openstack",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Bump the dated CentOS Stream 9 GenericCloud image used for IPA builds",
      "managerFilePatterns": [
        "jenkins/scripts/dynamic_worker_workflow/build_ipa.sh"
      ],
      "matchStrings": [
        "centos_upstream_img=\"CentOS-Stream-GenericCloud-9-(?<currentValue>[0-9]{8}\\.[0-9]+)\\.x86_64\\.qcow2\""
      ],
      "depNameTemplate": "CentOS-Stream-GenericCloud-9",
      "datasourceTemplate": "custom.centos-9-stream-genericcloud",
      "versioningTemplate": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the dated CentOS Stream 10 GenericCloud image used for CI image builds",
      "managerFilePatterns": ["jenkins/image_building/build-image.sh"],
      "matchStrings": [
        "centos_upstream_img=\"CentOS-Stream-GenericCloud-10-(?<currentValue>[0-9]{8}\\.[0-9]+)\\.x86_64\\.qcow2\""
      ],
      "depNameTemplate": "CentOS-Stream-GenericCloud-10",
      "datasourceTemplate": "custom.centos-10-stream-genericcloud",
      "versioningTemplate": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Bump the dated Ubuntu Noble cloud image release used for CI image builds",
      "managerFilePatterns": ["jenkins/image_building/build-image.sh"],
      "matchStrings": [
        "build_number=(?<currentValue>[0-9]{8}(?:\\.[0-9]+)?)"
      ],
      "depNameTemplate": "ubuntu-noble-cloud-image",
      "datasourceTemplate": "custom.ubuntu-noble-cloud-images",
      "versioningTemplate": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})(?:\\.(?<build>\\d+))?$"
    }
  ],
  "customDatasources": {
    "centos-9-stream-genericcloud": {
      "defaultRegistryUrlTemplate": "https://cloud.centos.org/centos/9-stream/x86_64/images/",
      "format": "html"
    },
    "centos-10-stream-genericcloud": {
      "defaultRegistryUrlTemplate": "https://cloud.centos.org/centos/10-stream/x86_64/images/",
      "format": "html"
    },
    "ubuntu-noble-cloud-images": {
      "defaultRegistryUrlTemplate": "https://cloud-images.ubuntu.com/releases/noble/",
      "format": "html"
    }
  }
}
