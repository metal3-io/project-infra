# CAPOCI controller credentials for the no-ESO / local-testing path.
# Copy to oci-variables.env (gitignored) and fill with real values.
# Each *_B64 value is the BASE64 encoding of the actual value:
#   printf '%s' 'ocid1.tenancy.oc1..aaaa'  | base64 -w0   # OCI_TENANCY_ID_B64
#   printf '%s' 'ocid1.user.oc1..bbbb'      | base64 -w0   # OCI_USER_ID_B64
#   printf '%s' 'aa:bb:cc:...'              | base64 -w0   # OCI_CREDENTIALS_FINGERPRINT_B64
#   printf '%s' 'eu-paris-1'                | base64 -w0   # OCI_REGION_B64
#   base64 -w0 < ~/.oci/oci_api_key.pem                    # OCI_CREDENTIALS_KEY_B64
#   printf '%s' 'false'                     | base64 -w0   # USE_INSTANCE_PRINCIPAL_B64
# A kind bootstrap must use user-principal auth (USE_INSTANCE_PRINCIPAL_B64=base64("false")).
OCI_TENANCY_ID_B64=REPLACE_ME
OCI_USER_ID_B64=REPLACE_ME
OCI_CREDENTIALS_FINGERPRINT_B64=REPLACE_ME
OCI_REGION_B64=REPLACE_ME
OCI_CREDENTIALS_KEY_B64=REPLACE_ME
USE_INSTANCE_PRINCIPAL_B64=REPLACE_ME
